generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Project {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  environments Environment[]
  grants       Grant[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Environment {
  id        String   @id @default(uuid())
  name      String
  projectId String
  createdAt DateTime @default(now())

  project Project  @relation(fields: [projectId], references: [id])
  secrets Secret[]

  @@unique([projectId, name])
  @@index([projectId])
}

model Secret {
  id               String   @id @default(uuid())
  key              String
  environmentId    String
  currentVersionId String?  @unique
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  environment    Environment     @relation(fields: [environmentId], references: [id])
  currentVersion SecretVersion?  @relation("CurrentSecretVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       SecretVersion[] @relation("SecretVersions")

  @@unique([environmentId, key])
  @@index([environmentId])
}

model SecretVersion {
  id          String   @id @default(uuid())
  secretId    String
  version     Int
  createdById String?
  createdAt   DateTime @default(now())
  note        String?

  ciphertext       Bytes
  valueIv          Bytes
  valueAuthTag     Bytes
  encryptedDataKey Bytes
  dataKeyIv        Bytes
  dataKeyAuthTag   Bytes
  keyVersion       String
  // Версія схеми шифрування рядка: 1 = legacy (AES-GCM без AAD),
  // 2 = AAD-binding (значення й data-key привʼязані до контексту секрету/версії).
  encryptionSchemaVersion Int @default(1)

  secret     Secret  @relation("SecretVersions", fields: [secretId], references: [id], onDelete: Cascade)
  currentFor Secret? @relation("CurrentSecretVersion")

  @@unique([secretId, version])
  @@index([secretId])
}

model Identity {
  id                    String   @id @default(uuid())
  name                  String
  email                 String?  @unique
  passwordHash          String?
  type                  String // "human" | "service"
  isSuperadmin          Boolean  @default(false)
  serviceOrganizationId String?
  lastActiveOrgId       String?
  createdAt             DateTime @default(now())

  tokens              Token[]
  sessions            Session[]
  grants              Grant[]
  memberships         OrganizationMembership[]
  serviceOrganization Organization?            @relation("OrganizationServiceAccounts", fields: [serviceOrganizationId], references: [id])

  @@index([serviceOrganizationId])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  type      String // "personal" | "team"
  status    String   @default("active")
  createdAt DateTime @default(now())

  memberships     OrganizationMembership[]
  projects        Project[]
  serviceAccounts Identity[]               @relation("OrganizationServiceAccounts")
}

model OrganizationMembership {
  id             String   @id @default(uuid())
  organizationId String
  identityId     String
  role           String // "owner" | "admin" | "member"
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identity     Identity     @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, identityId])
  @@index([identityId])
}

model Token {
  id         String    @id @default(uuid())
  identityId String
  tokenHash  String    @unique
  label      String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?

  identity Identity @relation(fields: [identityId], references: [id])

  @@index([identityId])
}

model Session {
  id          String    @id @default(uuid())
  identityId  String
  sessionHash String    @unique
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
}

model Grant {
  id                 String   @id @default(uuid())
  identityId         String
  projectId          String
  scopeType          String // "project" | "environment"
  scopeId            String
  role               String // "viewer" | "reader" | "developer" | "admin"
  canRevealSecrets   Boolean  @default(false)
  canCreateSecrets   Boolean  @default(false)
  canUpdateSecrets   Boolean  @default(false)
  canDeleteSecrets   Boolean  @default(false)
  canRollbackSecrets Boolean  @default(false)
  canManageGrants    Boolean  @default(false)
  createdAt          DateTime @default(now())

  identity Identity @relation(fields: [identityId], references: [id])
  project  Project  @relation(fields: [projectId], references: [id])

  @@unique([identityId, scopeType, scopeId])
  @@index([projectId])
}

model AuditLog {
  id               String   @id @default(uuid())
  actorId          String
  actorName        String
  organizationId   String?
  organizationName String?
  projectId        String?
  environmentId    String?
  action           String
  targetType       String
  targetId         String
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([organizationId])
  @@index([projectId])
  @@index([environmentId])
  @@index([action])
}
