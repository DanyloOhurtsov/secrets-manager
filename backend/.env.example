# ----------------------------------------------------------------------------
# Backend environment — copy this file to `.env` and fill in the values.
#
#   cp .env.example .env
#
# You only need this for running the backend DIRECTLY on your machine
# (`npm run start:dev`). If you use `docker compose up` from the repo root,
# the compose file already supplies working dev defaults — you can skip this.
# ----------------------------------------------------------------------------

# Postgres connection string. Matches docker-compose (Postgres on host port 5433).
DATABASE_URL="postgresql://dev:dev@localhost:5433/secrets_manager"

# Master encryption key(s). Comma-separated `version:hex` entries; each hex value
# must be exactly 32 bytes (64 hex chars). New secrets are wrapped with the
# ACTIVE_KEY_VERSION below. The app refuses to start if this is missing/invalid.
#
# Generate a fresh key with:
#   node -e "console.log('v1:' + require('crypto').randomBytes(32).toString('hex'))"
#
# For key rotation you can list multiple versions, e.g.:
#   MASTER_KEYS="v1:<64 hex>,v2:<64 hex>"
#
# The value below is an EXAMPLE for local development only — generate your own.
MASTER_KEYS="v1:ec03de457afe235850ec435f0aaaf9bf32dba3722eca106428c4f088f7403661"

# Which MASTER_KEYS version new secrets are wrapped with.
ACTIVE_KEY_VERSION="v1"

# Optional — Redis backs the token cache and rate-limit storage. Both degrade
# gracefully if Redis is down. Defaults to redis://localhost:6379 when unset.
REDIS_URL="redis://localhost:6379"

# Optional — HTTP port. Defaults to 3000.
# PORT="3000"

# Optional — set ONLY behind a trusted reverse proxy so Express resolves the real
# client IP from X-Forwarded-For for IP-based rate limiting (e.g. "1" = one hop).
# Never set to "true" on an open network. Leave unset otherwise.
# TRUST_PROXY="1"
