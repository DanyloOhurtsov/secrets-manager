# SENSITIVE configuration: DB password + master encryption key material.
#
# ############################################################################
# # PLACEHOLDERS ONLY — this file ships no usable values, on purpose.        #
# #                                                                          #
# #   cp 02-secret.yaml.example 02-secret.yaml                               #
# #   # then replace both CHANGE_ME values:                                  #
# #   echo "v1:$(openssl rand -hex 32)"                                      #
# #                                                                          #
# # 02-secret.yaml is gitignored. Never commit a real key, and never reuse   #
# # one you found in a repository — see SECURITY.md.                         #
# ############################################################################
#
# A native Kubernetes Secret is NOT encrypted — it is base64-encoded, which is
# encoding, not protection. `kubectl get secret app-secrets -o yaml | base64 -d`
# gives you the plaintext. What a Secret actually buys you over a ConfigMap:
#   - it is a distinct RBAC resource, so you can grant configmap access without
#     granting secret access;
#   - kubelet keeps it in tmpfs rather than on node disk when mounted as a volume;
#   - it is omitted from most logs, `kubectl describe`, and dashboards.
# Encryption at rest requires either an EncryptionConfiguration on the
# api-server or an external store (External Secrets Operator, Vault, SOPS).
#
# There is real irony in a *secrets manager* keeping its own root key in a
# Kubernetes Secret. That is unavoidable — MASTER_KEYS is the bootstrap key that
# unwraps everything else, so it has to come from outside the system it
# protects. In production it should come from a cloud KMS/HSM, not from here.

apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: secrets-manager
  labels:
    app.kubernetes.io/part-of: secrets-manager

# Opaque = arbitrary user-defined key/value data (as opposed to built-in types
# like kubernetes.io/tls or kubernetes.io/dockerconfigjson).
type: Opaque

# `stringData` accepts plaintext and the api-server base64-encodes it on write.
# `data` would require you to pre-encode every value by hand. stringData is
# write-only sugar: read the Secret back and you will see base64 under `data`.
stringData:
  # Consumed by BOTH the Postgres StatefulSet (which uses it to initialise the
  # cluster on first boot) and the API (which needs it inside DATABASE_URL).
  #
  # Caveat on the URL split: DATABASE_URL is assembled by string interpolation,
  # so a password containing @ : / ? # or % must be percent-encoded here or it
  # will corrupt the connection string. Prefer alphanumeric passwords, or move
  # the whole pre-built URL into this Secret as a single key.
  POSTGRES_PASSWORD: "CHANGE_ME"

  # Master key ring: comma-separated `version:hex`, each value exactly 32 bytes
  # (64 hex chars). KeyProvider validates this in its constructor and throws on
  # anything malformed — see the troubleshooting table in README.md for what
  # that failure looks like from the outside.
  MASTER_KEYS: "v1:CHANGE_ME_64_HEX_CHARS"

# --- Doing this properly ------------------------------------------------------
#
# Do not commit real keys. Delete this file's values and create the Secret
# imperatively instead — it never touches your git history:
#
#   kubectl create secret generic app-secrets \
#     --namespace secrets-manager \
#     --from-literal=POSTGRES_PASSWORD="$(openssl rand -hex 16)" \
#     --from-literal=MASTER_KEYS="v1:$(openssl rand -hex 32)"
#
# Rotating MASTER_KEYS is additive — append v2, flip ACTIVE_KEY_VERSION in the
# ConfigMap, restart, then POST /admin/rotate-keys to re-wrap existing data keys.
# Keep the old version in the ring until that rotation finishes, or every secret
# still wrapped with it becomes undecryptable.
